{
  "name": "vehkavaraus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "devdb": "docker compose -f compose.dev.yml up -d",
    "testdb": "docker compose -f compose.test.yml up -d",
    "resetdb": "docker compose -f compose.dev.yml down && rm -rf ./database/data",
    "enterdb": "docker exec -it vehkavaraus_db psql -U postgres",
    "entertestdb": "docker exec -it vehkavaraus_test psql -U postgres",
    "test": " vitest",
    "coverage": "vitest run --coverage",
    "migrate:dev": "cross-env NODE_ENV=development tsx ./src/database/migrations/utils/migrateDev.ts",
    "migrate:prod": "tsx ./src/database/migrations/utils/migrateProd.ts",
    "migrate:dev:down": "cross-env NODE_ENV=development tsx ./src/database/migrations/utils/migrateDevDown.ts",
    "migrate:prod:down": "tsx ./src/database/migrations/utils/migrateProdDown.ts",
    "migrate:test": "cross-env NODE_ENV=test tsx ./src/database/migrations/utils/migrateDev.ts",
    "checkTypes": "tsc --noEmit",
    "kysely": "kysely"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.4.26",
    "@react-email/components": "^1.0.12",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^2.4.3",
    "compressorjs": "^1.2.1",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.28.20",
    "kysely-neon": "^1.3.0",
    "next": "15.5.29",
    "next-auth": "^4.24.15",
    "pg": "^8.20.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^4.8.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "15.5.29",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.37",
    "@types/pg": "^8.18.0",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "4.1.12",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.33",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.1",
      "@types/react-dom": "19.0.1",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2 <2.1.7": "^2.1.7",
      "brace-expansion@>=5 <5.0.12": "^5.0.12",
      "flatted@<3.4.2": "^3.4.2",
      "js-cookie@<3.0.7": "^3.0.7",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "nanoid@<3.3.18": "^3.3.18",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4 <4.0.4": "^4.0.4",
      "postcss@<8.5.23": "^8.5.23",
      "postcss-selector-parser@<6.1.5": "^6.1.5",
      "prismjs@<1.30.0": "^1.30.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "yaml@<2.8.3": "^2.8.3",
      "zod@>=4 <4.6.6": "^4.6.7"
    }
  }
}
